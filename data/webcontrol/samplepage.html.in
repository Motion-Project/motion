<!DOCTYPE html>
<html lang='en'>
<head>
<meta charset='UTF-8'>
<title>Motion</title>
<meta name='viewport' content='width=device-width, initial-scale=1'>
  <style>
    * {
      margin: 0;
      padding: 0;
    }
    body {
      padding: 0;
      margin: 0;
      font-family: Arial, Helvetica, sans-serif;
      font-size: 1rem;
      line-height: 1;
      color: #606c71;
      background-color: #159957;
      background-image: linear-gradient(120deg, #155799, #159957);
      margin-left:0.5% ;
      margin-right:0.5% ;
      width: device-width ;
    }
    .page-header {
      color: #fff;
      text-align: center;
      margin-top: 0rem;
      margin-bottom: 0rem;
      font-weight: normal;
    }
    .page-header h3 {
      height: 2rem;
      padding: 0;
      margin: 1rem;
      border: 0;
    }
    h3 {
      margin-left: 10rem;
    }
    .header-right{
      float: right;
      color: white;
    }
    .header-center {
      text-align: center;
      color: white;
      margin-top: 1rem;
      margin-bottom: 1rem;
    }
    .border {
      border-width: 1rem;
      border-color: white;
      border-style: solid;
    }
    .sidenav {
      height: 100%;
      width: 10rem;
      position: fixed;
      z-index: 1;
      top: 0;
      left: 0;
      background-color: lightgrey;
      overflow-x: hidden;
      overflow: auto;
    }
    .sidenav a, .dropbtn {
      padding: 0.5rem 0rem 0.5em 1rem;
      text-decoration: none;
      font-size: 1rem;
      display: block;
      border: none;
      background: none;
      width:90%;
      text-align: left;
      cursor: pointer;
      outline: none;
      color: black;
      background-color: lightgray;
    }
    .sidenav a:hover, .dropbtn:hover {
      background-color: #555;
      color: white;
    }
    .sidenav .closebtn {
      color: black;
      top: 0;
      margin-left: 80%;
      width: 1rem;
      font-size: 1rem;
      background-color: lightgray;
    }
    .sidenav .closebtn:hover {
      background-color: lightgray;
      color: white;
    }
    .menubtn {
      top: 0;
      width: 1rem;
      margin-left: 0.5rem;
      margin-bottom: 0.25rem;
      font-size: 1.5rem;
      color:black;
      transform: rotate(90deg);
      -webkit-transform: rotate(90deg);
      background-color: transparent;
      border-color: transparent;
    }
    .menubtn:hover {
      color: white;
    }
    .dropdown-content {
      display: none;
      background-color:lightgray;
      padding-left: 1rem;
    }
    .actionbtn {
      padding: 0.25rem;
      text-decoration: none;
      font-size: 0.5rem;
      display: block;
      border: none;
      background: none;
      width: 3rem;
      text-align: center;
      cursor: pointer;
      outline: none;
      color: black;
      background-color: lightgray;
    }
    .cls_config {
      background-color: #000000;
      color: #fff;
      text-align: center;
      margin-top: 0rem;
      margin-bottom: 0rem;
      font-weight: normal;
      font-size: 0.90rem;
    }
    .cls_config label {
      padding: 0rem;
      text-align: right;
      width: 10rem;
      height: 2.5rem;
    }
    .cls_config textarea {
      margin: auto;
      text-align: center;
      width: 15.5rem;
      height: 2.5rem;
    }
    .cls_button {
      width: 10rem;
      height: 2rem;
      padding: 0rem;
    }
    .cls_drop {
      padding: 0rem;
      text-align: right;
      width: 10rem;
      height: 2.25rem;
    }
    .cls_text {
      padding: 0rem;
      width: 10em;
      text-align: right;
    }
    .cls_text_nbr {
      padding: 0rem;
      width: 10rem;
      text-align: right;
    }
    .cls_text_wide {
      padding: 0rem;
      height: 3rem;
      width: 20rem;
      text-align: right;
    }
    .cls_camdrop {
      /* Only used to identify all the cam drops on page */
    }
    .cls_samebtn {
      display: grid;
      /* Creates equal-width columns for as many buttons as you have */
      grid-auto-columns: 1fr;
      grid-auto-flow: column;
      /* Space between the buttons */
      gap: 12px;
      /* Aligns items so they stretch to match the tallest button's height */
      align-items: stretch;
      width: 100%;
      height: 100%;
    }
    .arrow {
      border: solid black;
      border-width: 0 1rem 1rem 0;
      border: double black;
      border-width: 0 0.75rem 0.75rem 0;
      display: inline-block;
      padding: 1rem;
      font-size: 0.5rem;
    }
    .right {
      transform: rotate(-45deg);
      -webkit-transform: rotate(-45deg);
    }
    .left {
      transform: rotate(135deg);
      -webkit-transform: rotate(135deg);
    }
    .up {
      transform: rotate(-135deg);
      -webkit-transform: rotate(-135deg);
    }
    .down {
      transform: rotate(45deg);
      -webkit-transform: rotate(45deg);
    }
    .zoombtn {
      font-size:1.25rem;
      width: 3rem;
      height: 1.5rem;
      margin: 0;
    }
    .cls_actions {
      background-color: transparent;
      color: white;
      text-align: center;
      margin-top: 0rem;
      margin-bottom: 0rem;
      font-weight: normal;
      font-size: 0.90rem;
    }
    .cls_movies {
      background-color: transparent;
      color: white;
      text-align: center;
      margin-top: 0rem;
      margin-bottom: 0rem;
      font-weight: normal;
      font-size: 0.90rem;
    }
    a:link {
      color: white;
      background-color: transparent;
      text-decoration: none;
    }
    a:visited {
      color: black;
      background-color: transparent;
      text-decoration: none;
    }
   .cls_log {
     background-color: transparent;
     color: white;
     text-align: center;
     margin-top: 0rem;
     margin-bottom: 0rem;
     font-weight: normal;
     font-size: 0.90rem;
   }
   .cls_log textarea {
     overflow-y: scroll;
     background-color: lightgrey;
     padding: 0rem;
     height: 10rem;
     width: 50rem;
     text-align: left;
   }
  </style>
</head>

<!-- Scripts fill out and replace these div items -->
<body class='body' onload='initform()'>
  <div id="divnav" class="sidenav">
    <a class='closebtn' onclick='nav_close()'>X</a>
    <div id="divnav_version"></div>
    <div id='divnav_cam_btn'></div>
    <div id='divnav_cam' class='dropdown-content'></div>
    <div id='divnav_actions_btn'></div>
    <div id='divnav_actions' class='dropdown-content'></div>
    <div id='divnav_config_btn'></div>
    <div id='divnav_config' class='dropdown-content'></div>
    <div id='divnav_movies_btn'></div>
    <div id='divnav_movies' class='dropdown-content'></div>
  </div>

  <div id='divmain' style='margin-left:10rem' >
    <button id='menu_btn'
      onclick='nav_open();'
      style='display:none'
      class='menubtn'>|||</button>
    <p></p>
    <div id='div_cam'></div>
    <div id='div_actions' class='cls_actions'></div>
    <div id='div_config'></div>
    <div id='div_movies' class='cls_movies'></div>
    <div id='div_log' class='cls_log' style='display:none' >
      <textarea id='txta_log' ></textarea>
    </div>
  </div>

  <script>

    var pData, pMovies, pHostFull;
    var gIndxScan, gIndxCam, gLogNbr;
    var log_timer;
    var scan_timerid;

    function nav_open() {
      document.getElementById('divnav').style.width = '10rem';
      document.getElementById('divmain').style.marginLeft = '10rem';
      document.getElementById('menu_btn').style.display= 'none';
    }

    function nav_close() {
      document.getElementById('divnav').style.width = '0rem';
      document.getElementById('divmain').style.marginLeft = '0rem';
      document.getElementById('menu_btn').style.display= 'inline';
    }

    function send_config_item(frmdata, pval, jkey, catkey) {
      var itm = document.getElementById(catkey);
      if (itm != null) {
        if (itm.type == 'checkbox') {
          if (pval != itm.checked) {
            frmdata.append(jkey, itm.checked);
          }
        } else if (pval != itm.value) {
          frmdata.append(jkey, itm.value);
        }
      } else {
        console.log("null element:"+catkey);
      }
    }

    function send_config(jcat, camid) {
      var formData = new FormData();
      var request = new XMLHttpRequest();
      var xmlhttp = new XMLHttpRequest();
      var catkey, ppfx, jkey, jkey2;
      var pCfg = pData['configuration'][jcat][camid];

      xmlhttp.onreadystatechange = function() {
        if (this.readyState == 4 && this.status == 200) {
          pData = JSON.parse(this.responseText);
        }
      };
      request.onreadystatechange = function() {
        if (this.readyState == 4 && this.status == 200) {
          xmlhttp.open('GET', pHostFull+'/0/config.json');
          xmlhttp.send();
        }
      };

      formData.append('command', 'config');
      formData.append('camid', camid);

      for (jkey in pCfg) {
        catkey = jcat+"-"+camid+"-"+jkey;
        send_config_item(formData, pCfg[jkey].value, jkey, catkey);
        if ((pCfg[jkey]["type"] == "params") && (pCfg[jkey]["count"]>0)) {
          ppfx=pCfg[jkey]["prefix"];
          for (jkey2 in pCfg[jkey]["detail"]) {
            catkey = jcat+"-"+camid+"-"+ppfx+jkey2;
            send_config_item(formData, pCfg[jkey]["detail"][jkey2].value, ppfx+jkey2, catkey);
          }
        }
      }

      request.open('POST', pHostFull);
      request.send(formData);
    }

    function send_action(actval) {
      var dsp_cam = document.getElementById('div_cam').style.display;
      if ((dsp_cam == 'none' || dsp_cam == '') && (actval != 'config_write')) {
        return;
      }

      var formData = new FormData();
      var camid;
      var ans;

      camid = assign_camid();

      if (actval == 'action_user') {
        ans = prompt('Enter user parameter');
      } else {
        ans = '';
      }

      formData.append('command', actval);
      formData.append('camid', camid);
      formData.append('user', ans);

      var request = new XMLHttpRequest();
      request.open('POST', pHostFull);
      request.send(formData);
    }

    function send_reload(actval) {
      var formData = new FormData();
      var request = new XMLHttpRequest();
      var xmlhttp = new XMLHttpRequest();
      var camid, ans;
      var pI10N = pData["i10n"];

      camid = assign_camid();

      if (actval == 'camera_delete') {
        ans = confirm(pI10N["deletecamera"]+" " + camid);
        if (ans == false) {
          return;
        }
      }

      xmlhttp.onreadystatechange = function() {
        if (this.readyState == 4 && this.status == 200) {
          pData = JSON.parse(this.responseText);
          gIndxCam = -1;
          assign_config_nav();
          assign_cams();
        }
      };
      request.onreadystatechange = function() {
        if (this.readyState == 4 && this.status == 200) {
          xmlhttp.open('GET', pHostFull+'/0/config.json');
          xmlhttp.send();

        }
      };
      formData.append('command', actval);
      formData.append('camid', camid);

      request.open('POST', pHostFull);
      request.send(formData);
    }

    function dropchange_actions(camobj) {
      var indx, camid;

      camid=camobj.value

      assign_actions_detail(camid)

      gIndxCam = -1;
      for (indx = 0; indx < pData['cameras']['count']; indx++) {
        if (pData['cameras'][indx]['id'] == camobj.value) {
          gIndxCam = indx;
        }
      }

      if (gIndxCam == -1) {
        document.getElementById('cfgpic').src =
          pHostFull+"/0/mjpg/stream";
      } else {
        document.getElementById('cfgpic').src =
          pData['cameras'][gIndxCam]['url'] + "mjpg/stream" ;
      }
    }

    function dropchange_cam(camobj) {
      var indx, camid;
      var html_cfg, jcat, catdesc;

      jcat = Number(camobj.name.substring(7));
      catdesc = pData['categories'][jcat]["name"];
      camid=camobj.value

      html_cfg = assign_config_cat_detail(jcat, camid)
      document.getElementById("div_"+catdesc+"_detail").innerHTML = html_cfg;

      assign_vals(jcat, camid);

      gIndxCam = -1;
      for (indx = 0; indx < pData['cameras']['count']; indx++) {
        if (pData['cameras'][indx]['id'] == camobj.value) {
          gIndxCam = indx;
        }
      }

      if (gIndxCam == -1) {
        document.getElementById('cfgpic').src =
          pHostFull+"/0/mjpg/stream";
      } else {
        document.getElementById('cfgpic').src =
          pData['cameras'][gIndxCam]['url'] + "mjpg/stream" ;
      }
    }

    function config_hideall() {
      var sect = document.getElementsByClassName('cls_config');
      for (var i = 0; i < sect.length; i++) {
        sect.item(i).style.display='none';
      }
    }

    function config_click(actval) {
      config_hideall();
      document.getElementById('div_cam').style.display='none';
      document.getElementById('div_actions').style.display='none';
      document.getElementById('div_movies').style.display='none';
      document.getElementById('div_config').style.display='inline';
      document.getElementById('div_' + actval).style.display='inline';
      document.getElementById('div_' + actval+'_detail').style.display='inline';
      cams_reset();
    }

    function actions_click() {
      config_hideall();
      document.getElementById('div_cam').style.display='none';
      document.getElementById('div_actions').style.display='inline';
      document.getElementById('div_movies').style.display='none';
      document.getElementById('div_config').style.display='none';
      cams_reset();
    }

    function assign_camid() {
      var camid;
      if (gIndxCam == -1 ) {
        camid = 0;
      } else {
        camid = pData['cameras'][gIndxCam]['id'];
      }
      return camid;
    }

    function assign_version() {
      var verstr ='<a>Motion \n'+pData['version'] +'</a>';
      document.getElementById('divnav_version').innerHTML = verstr;
    }

    function assign_cams() {
      var camcnt = pData['cameras']['count'];
      var indx;
      var html_cam = "\n", html_mov = "\n";
      var pI10N = pData["i10n"];

      for (indx=0; indx<camcnt; indx++) {
        if (indx == 0) {
          html_cam += "<a onclick='cams_all_click();'>";
          html_cam += pI10N["allcameras"]+"</a>\n";
          html_cam += "<a onclick='cams_scan_click();'>";
          html_cam += pI10N["scancameras"]+"</a>\n";
        }

        html_cam += "<a onclick='cams_one_click(" + indx + ");'>";
        html_cam += pData["cameras"][indx]["name"] + "</a>\n";
        html_mov += "<a onclick='movies_click(" + indx + ");'>";
        html_mov += pData["cameras"][indx]["name"] + "</a>";
      }

      document.getElementById("divnav_cam").innerHTML = html_cam;
      html_cam = "\n";
      html_cam += "<button onclick='display_cameras()'";
      html_cam += " id='cam_btn' class='dropbtn'>";
      html_cam += pI10N["cameras"]
      html_cam += "</button>";
      document.getElementById("divnav_cam_btn").innerHTML = html_cam;

      document.getElementById("divnav_movies").innerHTML = html_mov;
      html_mov = "\n";
      html_mov += "<button onclick='display_movies()'";
      html_mov += " id='mov_btn' class='dropbtn'>";
      html_mov += pI10N["recordings"]
      html_mov += "</button>";
      document.getElementById("divnav_movies_btn").innerHTML = html_mov;

    }

    function assign_actions() {
      var html_actions;
      var pI10N = pData["i10n"];

      html_actions = "\n";
      html_actions += "<button onclick='display_actions()'";
      html_actions += " id='actions_btn' class='dropbtn'>";
      html_actions += pI10N["actions"];
      html_actions += "</button>";
      document.getElementById("divnav_actions_btn").innerHTML = html_actions;
      assign_actions_drop();
    }

    function assign_actions_detail(camid) {
      var html_act;
      var pI10N = pData["i10n"];

      html_act = "\n";
      html_act += "<table style='float: left'>";
      html_act += "<tr><td>"+build_nbsp(4)+"</td></tr>\n";
      html_act += "<tr>";
      html_act += "<td>"+build_nbsp(4)+"</td>";
      html_act += "<td><button class=cls_samebtn onclick=\"send_action(";
      html_act += "'eventstart');\">";
      html_act += pI10N["startevent"]+"</td>\n";
      html_act += "<td>"+build_nbsp(4)+"</td>";
      html_act += "<td><button class=cls_samebtn onclick=\"send_action(";
      html_act += "'eventend');\">";
      html_act += pI10N["endevent"]+"</td>\n";
      html_act += "</tr>";

      html_act += "<tr><td>"+build_nbsp(4)+"</td></tr>\n";
      html_act += "<tr>";
      html_act += "<td>"+build_nbsp(4)+"</td>";
      html_act += "<td><button class=cls_samebtn onclick=\"send_action(";
      html_act += "'snapshot');\">";
      html_act += pI10N["snapshot"]+"</td>\n";
      html_act += "</tr>";

      html_act += "<tr><td>"+build_nbsp(4)+"</td></tr>\n";
      html_act += "<tr>";
      html_act += "<td>"+build_nbsp(4)+"</td>";
      html_act += "<td><button class=cls_samebtn onclick=\"send_action(";
      html_act += "'pause');\">";
      html_act += pI10N["pause"]+"</td>\n";
      html_act += "<td>"+build_nbsp(4)+"</td>";
      html_act += "<td><button class=cls_samebtn onclick=\"send_action(";
      html_act += "'unpause');\">";
      html_act += pI10N["unpause"]+"</td>\n";
      html_act += "</tr>";

      html_act += "<tr><td>"+build_nbsp(4)+"</td></tr>\n";
      html_act += "<tr>";
      html_act += "<td>"+build_nbsp(4)+"</td>";
      html_act += "<td><button class=cls_samebtn onclick=\"send_action(";
      html_act += "'restart');\">";
      html_act += pI10N["startrestart"]+"</td>\n";
      html_act += "<td>"+build_nbsp(4)+"</td>";
      html_act += "<td><button class=cls_samebtn onclick=\"send_action(";
      html_act += "'stop');\">";
      html_act += pI10N["stop"]+"</td>\n";
      html_act += "</tr>";

      html_act += "<tr><td>"+build_nbsp(4)+"</td></tr>\n";
      html_act += "<tr>";
      html_act += "<td>"+build_nbsp(4)+"</td>";
      html_act += "<td><button class=cls_samebtn onclick=\"send_action(";
      html_act += "'config_write');\">";
      html_act += pI10N["saveconfig"]+"</td>\n";
      html_act += "</tr>";

      if (camid == 0) {
        html_act += "<tr><td>"+build_nbsp(4)+"</td></tr>\n";
        html_act += "<tr>";
        html_act += "<td>"+build_nbsp(4)+"</td>";
        html_act += "<td><button class=cls_samebtn onclick=\"send_action(";
        html_act += "'camera_add');\">";
        html_act += pI10N["addcamera"]+"</td>\n";
        html_act += "<td>"+build_nbsp(4)+"</td>";
        html_act += "<td><button class=cls_samebtn onclick=\"send_action(";
        html_act += "'camera_delete');\">";
        html_act += pI10N["deletecamera"]+"</td>\n";
        html_act += "</tr>";
      }

      html_act += "<tr><td>"+build_nbsp(4)+"</td></tr>\n";
      html_act += "<tr>";
      html_act += "<td>"+build_nbsp(4)+"</td>";
      html_act += "<td><button class=cls_samebtn onclick=\"send_action(";
      html_act += "'action_user');\">";
      html_act += pI10N["useraction"]+"</td>\n";
      html_act += "<td>"+build_nbsp(4)+"</td>";
      html_act += "<td><button class=cls_samebtn onclick=\"send_action(";
      html_act += "'log_showhide');\">";
      html_act += pI10N["showhidelog"]+"</td>\n";
      html_act += "</tr>";
      html_act += "<table>";

      document.getElementById("div_actions_detail").innerHTML = html_act;

    }

    function assign_vals_item(pCfg, jkey, catkey) {
      var itm;
      itm =document.getElementById(catkey);
      if (itm != null) {
        if (pCfg[jkey].enabled) {
          itm.disabled = false;
          if (itm.type == "checkbox") {
            itm.checked = pCfg[jkey].value;
          } else {
            itm.value = pCfg[jkey].value;
          }
        } else {
          itm.disabled = true;
          itm.value = '';
        }
      }
    }

    function assign_vals(jcat, camid) {
      var pCfg, catkey, jkey, jkey2;
      pCfg = pData["configuration"][jcat][camid];
      for (jkey in pCfg) {
        catkey = jcat+"-"+camid+"-"+jkey;
        assign_vals_item(pCfg, jkey, catkey);
        if ((pCfg[jkey]["type"] == "params") && (pCfg[jkey]["count"] > 0)) {
          for (jkey2 in pCfg[jkey]["detail"]) {
            catkey = jcat+"-"+camid+"-"+pCfg[jkey]["prefix"]+jkey2;
            assign_vals_item(pCfg[jkey]["detail"], jkey2, catkey);
          }
        }
      }
    }

    function assign_config_nav() {
      var pCat = pData['categories'];
      var pI10N=pData["i10n"];
      var html_nav, jcat;

      html_nav = "\n";
      html_nav += "<button";
      html_nav += " onclick='display_config()' id='cfg_btn' class='dropbtn'>";
      html_nav += pI10N["configuration"];
      html_nav += "</button>";
      document.getElementById("divnav_config_btn").innerHTML = html_nav;

      html_nav = "\n";
      for (jcat in pCat) {
        html_nav += "<a onclick=\"config_click('";
        html_nav += pCat[jcat]["name"]+"');\">";
        html_nav += pCat[jcat]["display"]+"</a>\n";
      }

      document.getElementById("divnav_config").innerHTML = html_nav;
    }

    function params_showhide(rowid) {
      if (document.getElementById(rowid).style.display == "") {
        document.getElementById(rowid).style.display = "none"
      } else {
        document.getElementById(rowid).style.display = "";
      }
    }

    function build_nbsp(pcnt) {
      var indx, rslt="";
      for (indx=0;indx<pcnt;indx++) {
        rslt += "&nbsp";
      }
      return rslt;
    }

    function assign_config_item(pCfg, catkey, jcat, camid, jNm) {
      var html_cfg = "";
      var indx_lst;
      var pI10N = pData["i10n"];

      if (pCfg["type"] == "string") {
        html_cfg += "<td><textarea ";
        html_cfg += " id='"  +catkey +"'";
        html_cfg += " name='"+catkey +"'";
        html_cfg += "></textarea></td>";
        html_cfg += "</tr>\n";

      } else if (pCfg["type"] == "params") {
        html_cfg += "<td><textarea ";
        html_cfg += " id='"  +catkey +"'";
        html_cfg += " name='"+catkey +"'";
        html_cfg += "></textarea></td>";
        if (pCfg["count"] == 0) {
          /* Nothing has been parsed */
          html_cfg += "</tr>\n";
        } else {
          html_cfg += "<td> <button onclick=params_showhide(";
          html_cfg += "'"+"rowid-"+catkey+"'"
          html_cfg += ")>"+pI10N["showhide"]+"</button></td></tr>\n";
          html_cfg += assign_config_params(pCfg["detail"], jcat, camid, jNm, pCfg["prefix"]);
        }

      } else if (pCfg["type"] == "bool") {
        html_cfg += "<td><input class='cfg_check'";
        html_cfg += " type='checkbox' ";
        html_cfg += " id='"  +catkey +"'";
        html_cfg += " name='"+catkey +"'";
        html_cfg += "></td>";
        html_cfg += "</tr>\n";

      } else if (pCfg["type"] == "int") {
        html_cfg += "<td><input class='cls_text_nbr'";
        html_cfg += " type='text'";
        html_cfg += " id='"  +catkey +"'";
        html_cfg += " name='"+catkey +"'";
        html_cfg += "></td>";
        html_cfg += "</tr>\n";

      } else if (pCfg["type"] == "float") {
        html_cfg += "<td><input class='cls_text_nbr'";
        html_cfg += " type='text'";
        html_cfg += " id='"  +catkey +"'";
        html_cfg += " name='"+catkey +"'";
        html_cfg += "></td>";
        html_cfg += "</tr>\n";

      } else if (pCfg["type"] == "list") {
        html_cfg += "<td><select class='cls_drop' ";
        html_cfg += " id='"  +catkey +"'";
        html_cfg += " name='"+catkey +"'";
        html_cfg += " autocomplete='off'>";
        for (indx_lst=0; indx_lst < pCfg["list"].length; indx_lst++) {
          html_cfg += "<option value='";
          html_cfg += pCfg["list"][indx_lst] + "'>";
          html_cfg += pCfg["list"][indx_lst] + "</option>\n";
        }
        html_cfg += "</select></td>";

      } else if (pCfg["type"] == "intlist") {
        html_cfg += "<td><select class='cls_drop'";
        html_cfg += " id='"  +catkey +"'";
        html_cfg += " name='"+catkey +"'";
        html_cfg += " autocomplete='off'>";
        for (indx_lst=0; indx_lst < pCfg["list"].length; indx_lst++) {
          html_cfg += "<option value='";
          html_cfg += pCfg["list"][indx_lst] + "'>";
          html_cfg += pCfg["list"][indx_lst] + "</option>\n";
        }
        html_cfg += "</select></td>";
        html_cfg += "</tr>\n";

      } else {
        console.log("uncoded data type:"+pCfg["type"])
        html_cfg += "<td><textarea ";
        html_cfg += " id='"  +catkey +"'";
        html_cfg += " name='"+catkey +"'";
        html_cfg += "></textarea></td>";
        html_cfg += "</tr>\n";

      }

      return html_cfg;
    }

    function assign_config_params(pCfg, jcat, camid, jNm, ppfx) {
      var html_cfg = "";
      var jkey, rowid, catkey;

      rowid = "rowid-"+jcat+"-"+camid+"-"+jNm;
      html_cfg += "<tr id='"+rowid+"' style='display:none'>";
      html_cfg += "<td colspan='2' >"
      html_cfg += "<table style='margin-left: 60px' border='1' width='40%' >";

      for (jkey in pCfg) {
        catkey = jcat+"-"+camid+"-"+ppfx+jkey;
        html_cfg += "<tr>";
        html_cfg += "<td>";
        html_cfg += "<label for='"+ catkey + "'>"+jkey;
        if (pCfg[jkey]["desc"] != "") {
          html_cfg += "("+pCfg[jkey]["desc"]+")";
        }
        html_cfg += "</label></td>\n";
        html_cfg += assign_config_item(pCfg[jkey], catkey, jcat, camid, jkey);
      }
      html_cfg += "</table>";
      html_cfg += "</td>";
      html_cfg += "</tr>";

      return html_cfg;
    }

    function assign_config_cat_detail(jcat, camid) {
      var pCfg = pData['configuration'][jcat][camid];
      var catkey, html_cfg, jkey;

      html_cfg = "<table style='float: left' width='40%'>";

      for (jkey in pCfg) {
        catkey = jcat+"-"+camid+"-"+jkey;
        html_cfg += "<tr>";
        html_cfg += "<td>";
        html_cfg += "<label for='"+ catkey + "'>"+jkey;
        if (pCfg[jkey]["desc"] != "") {
          html_cfg += "("+pCfg[jkey]["desc"]+")";
        }
        html_cfg += "</label></td>\n";
        html_cfg += assign_config_item(pCfg[jkey], catkey, jcat, camid, jkey);
      }
      html_cfg += "<tr><td>"+build_nbsp(8)+"</td><td>"+build_nbsp(8)+"</td></tr>\n";
      html_cfg += "<tr><td><input type='hidden' name='trailer' value='null'></td>\n";
      html_cfg += "<td> <button onclick='send_config(";
      html_cfg += jcat+","+camid+")'>Submit</button></td></tr>\n";
      html_cfg += "</table>";

      return html_cfg;
    }

    function assign_config_drop(jcat) {
      var pCat = pData['categories'][jcat];
      var camcnt = pData['cameras']['count'];
      var pI10N = pData["i10n"];
      var indx, html_cfg = "";
      var jdropid = "camdrop"+jcat;

      html_cfg += "<div id='div_";
      html_cfg += pCat["name"];
      html_cfg += "' style='display:none' class='cls_config'>\n";
      html_cfg += "<table>";
      html_cfg += "<tr><th colspan='2'>";
      html_cfg += pCat["display"]+" "+pI10N["parameters"];
      html_cfg += "</th></tr>\n";
      html_cfg += "<tr><td><label ";
      html_cfg += " for='"+jdropid+"'";
      html_cfg += ">"+pI10N["camera"]+"</label></td>\n";
      html_cfg += "<td class='cls_camdrop'>\n";
      html_cfg += "<select class='cls_drop' ";
      html_cfg += "onchange='dropchange_cam(this)' ";
      html_cfg += " name='"+jdropid+"'";
      html_cfg += " id='"+jdropid+"'>\n";
      html_cfg += "<option value='' disabled hidden selected>";
      html_cfg += pI10N["selectcamera"]+"</option>\n";
      html_cfg += "<option value='0'>"+pI10N["default"]+"</option>\n";
      for (indx=0; indx<camcnt; indx++) {
        html_cfg += "<option ";
        html_cfg += " value='"+pData["cameras"][indx]["id"]+"'>";
        html_cfg += pData["cameras"][indx]["name"];
        html_cfg += "</option>\n";
      }
      html_cfg += "</select></td></tr>\n";
      html_cfg += "</table>\n";
      html_cfg += "</div>\n";

      html_cfg += "<div id='div_"+pCat["name"]+"_detail' ";
      html_cfg += " style='display:none' class='cls_config'> ";
      html_cfg += " <br> ";
      html_cfg += "</div>";

      return html_cfg;
    }

    function assign_actions_drop() {
      var camcnt = pData['cameras']['count'];
      var pI10N = pData["i10n"];
      var indx, html_act = "";
      var jdropid = "actiondrop";

      html_act += "<div id='div_actions_drop' ";
      html_act += " class='cls_actions'>\n";
      html_act += "<table>";
      html_act += "<tr><th colspan='2'>";
      html_act += pI10N["actions"];
      html_act += "</th></tr>\n";
      html_act += "<tr><td><label ";
      html_act += " for='"+jdropid+"'";
      html_act += ">"+pI10N["camera"]+"</label></td>\n";
      html_act += "<td class='cls_camdrop'>\n";
      html_act += "<select class='cls_drop' ";
      html_act += "onchange='dropchange_actions(this)' ";
      html_act += " name='"+jdropid+"'";
      html_act += " id='"+jdropid+"'>\n";
      html_act += "<option value='' disabled hidden selected>";
      html_act += pI10N["selectcamera"]+"</option>\n";
      html_act += "<option value='0'>"+pI10N["default"]+"</option>\n";
      for (indx=0; indx<camcnt; indx++) {
        html_act += "<option ";
        html_act += " value='"+pData["cameras"][indx]["id"]+"'>";
        html_act += pData["cameras"][indx]["name"];
        html_act += "</option>\n";
      }
      html_act += "</select></td></tr>\n";
      html_act += "</table>\n";
      html_act += "</div>\n";

      html_act += "<div id='div_actions_detail' ";
      html_act += " class='cls_actions'> ";
      html_act += " <br> ";
      html_act += "</div>";

      document.getElementById("div_actions").innerHTML = html_act;

    }

    function assign_config() {
      var pCat = pData['categories'];
      var html_cfg = "", jcat;

      assign_config_nav();

      for (jcat in pCat) {
        html_cfg += assign_config_drop(jcat);
      }

      html_cfg += "<br><br><br>";
      html_cfg += "<a><img id='cfgpic'";
      html_cfg += " src=" + pHostFull + "/0/mjpg/stream";
      html_cfg += " border=0 width=45%></a>\n";
      html_cfg += "<div style='clear: both'></div>\n;"

      document.getElementById("div_config").innerHTML = html_cfg;

    }

    function initform() {
      var xmlhttp = new XMLHttpRequest();

      pHostFull = '//' + window.location.hostname;
      pHostFull = pHostFull + ':' + window.location.port;

      xmlhttp.onreadystatechange = function() {
        if (this.readyState == 4 && this.status == 200) {
          pData = JSON.parse(this.responseText);
          gIndxCam  = -1;
          gIndxScan = -1;
          gLogNbr = 0;

          assign_config();

          assign_version();
          assign_cams();
          assign_actions();
          cams_all_click();
          nav_close();
        }
      };
      xmlhttp.open('GET', pHostFull+'/0/config.json');
      xmlhttp.send();
    }

    function display_cameras() {
      document.getElementById('divnav_config').style.display = 'none';
      document.getElementById('divnav_actions').style.display = 'none';
      document.getElementById('divnav_movies').style.display = 'none';
      if (document.getElementById('divnav_cam').style.display == 'block'){
        document.getElementById('divnav_cam').style.display = 'none';
      } else {
        document.getElementById('divnav_cam').style.display = 'block';
      }
    }

    function display_config() {
      document.getElementById('divnav_cam').style.display = 'none';
      document.getElementById('divnav_actions').style.display = 'none';
      document.getElementById('divnav_movies').style.display = 'none';
      if (document.getElementById('divnav_config').style.display == 'block') {
        document.getElementById('divnav_config').style.display = 'none';
      } else {
        document.getElementById('divnav_config').style.display = 'block';
      }
      gIndxScan = -1;
      cams_timer_stop();
    }

    function display_movies() {
      document.getElementById('divnav_cam').style.display = 'none';
      document.getElementById('divnav_actions').style.display = 'none';
      document.getElementById('divnav_config').style.display = 'none';
      if (document.getElementById('divnav_movies').style.display == 'block') {
        document.getElementById('divnav_movies').style.display = 'none';
      } else {
        document.getElementById('divnav_movies').style.display = 'block';
      }
      gIndxScan = -1;
      cams_timer_stop();
